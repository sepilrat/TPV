+                "nivel": "sin_costo"}
+    margen = precio - costo
+    pct = margen / costo * 100
+    if margen < -0.005:
+        nivel = "perdida"
+    elif pct < minimo:
+        nivel = "bajo"
+    else:
+        nivel = "ok"
+    return {"precio": precio, "costo": costo, "margen": margen, "pct": pct,
