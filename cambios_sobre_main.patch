+def tareas_de_script(salida_schtasks: str, script: str) -> list:
+    """Bloques de `schtasks /query /v /fo LIST` que ejecutan `script`.
+
+    Cada tarea es un bloque separado por una linea en blanco; sirve igual
+    con Windows en espanol o en ingles, porque solo busca el nombre del
+    script dentro del bloque.
+    """
+    return [b for b in salida_schtasks.replace("\r\n", "\n").split("\n\n")
+            if script.lower() in b.lower()]
+
+
+def tarea_sigue_la_hora_de_config(bloque: str) -> bool:
+    """True si la tarea usa --programado (el script lee la hora de Config)."""
+    return "--programado" in bloque
+
+
+def _resumen_tarea(bloque: str) -> list:
+    claves = ("nombre de tarea", "taskname", "estado:", "status:", "ultima ejecuci",
+              "\u00faltima ejecuci", "last run time", "ultimo resultado",
+              "\u00faltimo resultado", "last result", "proxima ejecuci",
+              "pr\u00f3xima ejecuci", "next run time")
+    return [l.strip() for l in bloque.splitlines()
+            if any(l.strip().lower().startswith(k) for k in claves)]
+
+
